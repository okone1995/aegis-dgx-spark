{"schema_version": 1, "run_id": "run-20260927-140612-399b", "seq": 16, "event_id": "run-20260927-140612-399b:16", "ts": "2026-09-27T14:07:24.742Z", "type": "patch.proposed", "stage": "patch", "actor": "demo_case", "flow_id": "", "finding_id": "F-001", "caused_by": "", "status": "", "summary": "", "payload": {"finding_id": "F-001", "mode": "llm_guided", "sha256": "ac34f26f45e20589b3e124a8804040b1570d57eaa02b45bc68b043e6301e612a", "orig_sha256": "4b7c0d2d2e9a7a03303eb1b9540a152ca8f1e352cbd234c203ce08111e1bcfd5", "model": "qwen", "provider": "qwen", "call_id": "run-20260927-140612-399b:c4", "template": "fix.patch.tpl", "template_sha256": "00e18b39d6ec30609c7c57e8e1655462915f77d82c192b745751df5a79a09cdf", "diff": "--- \n+++ \n@@ -108,15 +108,8 @@\n     if (!session_user()) { header('Location: /login'); exit; }\n     $q = $_GET[$CFG['search_param']] ?? '';\n-    // 【VULN sqli】字符串拼接进 SQL（故意，插件 sqli 的注入点）\n-    $sql = \"SELECT id, title, body FROM news WHERE title LIKE '%{$q}%' OR body LIKE '%{$q}%'\";\n-    try {\n-        $res = db()->query($sql);\n-        $out = '';\n-        // 故意不转义：UNION 注入可控列 = xss_stored 插件（D4）预留的二阶 XSS 面（与 /news 列表的转义形成对照）\n-        while ($r = $res->fetchArray(SQLITE3_ASSOC)) $out .= '<li><b>' . $r['title'] . '</b> — ' . $r['body'] . '</li>';\n-    } catch (Exception $e) {\n-        http_response_code(500);\n-        die(html('错误', '<p>SQL error: ' . htmlspecialchars($e->getMessage()) . '</p>'));\n-    }\n+    // [patched sqli] 参数化查询：q_all() 助手（prepare/bindValue/execute），用户输入不再拼接进 SQL\n+    $rows = q_all(\"SELECT id, title, body FROM news WHERE title LIKE ? OR body LIKE ?\", [\"%{$q}%\", \"%{$q}%\"]);\n+    $out = '';\n+    foreach ($rows as $r) $out .= '<li><b>' . htmlspecialchars($r['title']) . '</b> — ' . htmlspecialchars($r['body']) . '</li>';\n     die(html('搜索', \"<p>关键字: \" . htmlspecialchars($q) . \"</p><ul>{$out}</ul>\"));\n }", "diff_sha256": "d0d2d8fa71a525a43f628a1684a3bcd8b7cd365ef2c6d9bac8c205835d865d50", "artifact": "patches/F-001.candidate.php"}, "artifact_refs": []}
